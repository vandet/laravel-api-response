{
    "name": "vandet/laravel-api-response",
    "description": "Laravel package that enforces a consistent API response envelope — success, paginated, error, and bulk partial failure — across all services.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "api",
        "response",
        "json",
        "envelope",
        "rest",
        "http"
    ],
    "authors": [
        {
            "name": "Vandet",
            "email": "seanvandet@gmail.com",
            "homepage": "https://github.com/vandet",
            "role": "Developer"
        }
    ],
    "homepage": "https://github.com/vandet/laravel-api-response",
    "support": {
        "issues": "https://github.com/vandet/laravel-api-response/issues",
        "source": "https://github.com/vandet/laravel-api-response"
    },
    "require": {
        "php": "^8.2",
        "illuminate/http": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "symfony/http-kernel": "^6.4|^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0|^11.0|^12.0",
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "illuminate/auth": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/database": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/pagination": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/validation": "^10.0|^11.0|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "Vandet\\ApiResponse\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Vandet\\ApiResponse\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Vandet\\ApiResponse\\ApiResponseServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {}
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
